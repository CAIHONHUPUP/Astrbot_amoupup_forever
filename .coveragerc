[run]
source = .
omit =
    tests/*
    tools/*
    __pycache__/*
    .test-tmp/*
    pytest-cache-files-*

[report]
# 只许往上调：第三轮把 30% 抬到 40%；2026-11-12 补 api/日程/分段/消息层测试后实测 57%，
# 7.0.0 加了类型注解与守卫后实测 60%，底线 52% → 58%（留 2 个点抖动余量）。
# 2026-11-18 全量 coverage 实测 70%（含 work/ 脚本），按 5 个点余量抬到 65；
# 2026-11-18 晚补 15 个 cov2 测试 + 多日仿真进 CI 后实测 78%，底线 65 -> 78（只许往上调）。
fail_under = 78
show_missing = True
skip_covered = True
