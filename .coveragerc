[run]
source = .
omit =
    tests/*
    tools/*
    __pycache__/*
    .test-tmp/*
    pytest-cache-files-*

[report]
# 测试会临时生成/删除探针文件，报告时找不到源码直接跳过（2026-11-19）。
ignore_errors = true
# 演变：第三轮把 30% 抬到 40%；2026-11-12 补 api/日程/分段/消息层测试后实测 57%，
# 7.0.0 加了类型注解与守卫后实测 60%，底线 52% → 58%（留 2 个点抖动余量）。
# 2026-11-18 全量 coverage 实测 70%（含 work/ 脚本），按 5 个点余量抬到 65；
# 2026-11-18 晚补 15 个 cov2 测试 + 多日仿真进 CI 后实测 78%，底线 65 -> 78。
# 2026-11-19 用户要求降到 75：CI 实测 78.4%、余量只有 0.4 个点，任何小改动都会假红；
# 降到 75 留 3 个点余量。以后要往上抬，先补测再抬。
#
# 2026-11-24（8.0.0）：仓库收口时 tests/ 从 504 个文件裁剪到 29 个（只剩契约/接线测试），
# 全量 454 项跑下来实测 25%。75% 是旧树（6430 项）的口径，不适用于收口后的树，
# 按用户当次决定降到 23（实测 25% 留 2 个点余量），保证 CI 能绿、能正常发版。
# 硬要求：把归档测试按现有模块移植回来后，必须把这里往上抬（抬之前先实测，别拍脑袋）。
fail_under = 23
show_missing = True
skip_covered = True
