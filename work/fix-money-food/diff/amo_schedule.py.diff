+_DIARY_LABEL_EXTRA_WORDS = frozenset(("周末", "节气", "节日", "假期"))
+_DIARY_DATE_HEAD_RE = re.compile(r"^\s*(\d{4})年(\d{1,2})月(\d{1,2})日")
+_DIARY_LABEL_TOKEN_RE = re.compile(r"[\s，,、·]*([^\s，,、·【】\[\]()（）:：]{1,8})")
