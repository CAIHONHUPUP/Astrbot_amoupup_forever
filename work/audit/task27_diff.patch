+        _row("rent:2026-11", -185303, "房租", "其他"),                    # 旧库 category 被回填“其他”
+        _row("water:2026-11", -1929, "水费", "其他"),
+        _row("bank:dep:2026-11-16", -1000000, "存款：定期3个月", "存款"),
+        _row("decision:fundbuy", -50000, "buy_fund", "投资"),
