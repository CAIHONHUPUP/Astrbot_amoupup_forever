+        _row("cleanup:refund:1", 20000, "退款：预扣已退回", "退款"),
+        _row("salary:2026-11", 680000, "工资", "工资"),
+        _row("meal:oct", -300, "早餐", "餐饮",
+             dt.datetime(2026, 10, 31, 9, 0).timestamp()),
+        _row("init:1", 2090104, "可取余额初始化", "其他", account="withdrawable"),
+    ]
